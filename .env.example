# --- Database (shared Postgres, e.g. Neon/Supabase free tier) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/agentic_lms

# --- Moodle (local Docker instance, per-person) ---
MOODLE_BASE_URL=http://localhost:8080
MOODLE_WS_TOKEN=replace_with_generated_token

# --- LLM backends (no OpenAI / no Anthropic) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b

OPENROUTER_API_KEY=replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=replace_me   # pick a free-tier model from openrouter.ai/models

GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-1.5-flash

# Which backend each agent defaults to: ollama | openrouter | gemini
DEFAULT_LLM_BACKEND=gemini

# --- App ---
ENV=development
