# --- Database (shared Postgres, e.g. Neon/Supabase free tier) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/agentic_lms

# --- Moodle (local Docker instance, per-person) ---
MOODLE_BASE_URL=http://localhost:8080
MOODLE_WS_TOKEN=replace_with_generated_token

# --- LLM backends (no OpenAI / no Anthropic) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

OPENROUTER_API_KEY=replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=replace_me   # pick a free-tier model from openrouter.ai/models

GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash

# Which backend each agent defaults to: ollama | openrouter | gemini
DEFAULT_LLM_BACKEND=gemini

# --- App ---
ENV=development

# --- Code runner (docker = sandboxed; local = dev only, not isolated) ---
CODE_RUNNER_MODE=docker
CODE_RUNNER_IMAGE=agentic-lms-runner
CODE_TIME_LIMIT_S=2.0

# --- App database (quizzes, attempts, marks) ---
# Default: local SQLite file. Supabase: use the *Session pooler* string from Supabase > Connect,
# with postgresql+psycopg2:// at the start and ?sslmode=require at the end.
# APP_DB_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
